# Локальный frontend without Docker (Режим A/B)
# mock -- localStorage-реализации репозиториев (режим по умолчанию для локальной разработки).
# http -- реальный backend (Flask) через src/repositories/http/apiClient.js.
VITE_API_MODE=http

# Базовый URL backend API. Для docker-compose фронтенд обращается к nginx same-origin
# reverse-proxy, поэтому значение по умолчанию -- /api.
VITE_API_BASE_URL=/api

# Docker Compose / production deployment
POSTGRES_USER=todo_planner
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=todo_planner
DATABASE_URL=postgresql+psycopg2://todo_planner:change-me-in-production@db:5432/todo_planner

# Обязательно: без реального значения `docker compose up` упадёт с ошибкой
# (docker-compose.yml.SECRET_KEY: ${SECRET_KEY:?...} и backend/config.py fail-fast не допускают плейсхолдеры).
# Сгенерируйте: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

FRONTEND_ORIGIN=http://localhost

# cookie SameSite для backend-сессий (Lax -- same-origin дефолт; None -- только вместе с HTTPS).
SESSION_COOKIE_SAMESITE=Lax

# Rate limiting POST /api/auth/login (Flask-Limiter).
RATELIMIT_STORAGE_URI=memory://
LOGIN_RATE_LIMIT=10 per minute;50 per hour

# Сколько дней хранить ежедневные pg_dump-бэкапы (сервис `backup` в docker-compose.yml).
BACKUP_RETENTION_DAYS=14
