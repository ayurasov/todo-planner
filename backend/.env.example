FLASK_ENV=development
# production: обязательна длинная случайная строка, без неё приложение не стартует (config.py):
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-key
SQLALCHEMY_DATABASE_URI=sqlite:///../todo_planner.db
FRONTEND_ORIGIN=http://localhost:5173
SESSION_TYPE=filesystem
# Lax подходит, если frontend и backend на одном domain (навигация через nginx);
# поставьте None (и обязательно HTTPS), если frontend/backend на разных origin.
SESSION_COOKIE_SAMESITE=Lax
# Rate limiting POST /api/auth/login (Flask-Limiter). для single-instance backend
# дефолтный memory:// storage достаточен; для нескольких worker'ов/реплик --
# redis://host:6379/0.
RATELIMIT_ENABLED=true
RATELIMIT_STORAGE_URI=memory://
LOGIN_RATE_LIMIT=10 per minute;50 per hour
