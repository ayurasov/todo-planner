# Переменные для docker-compose (продовый деплой). Скопируйте в .env рядом
# с docker-compose.yml перед `docker compose up -d --build`.

# --- Postgres (сервис db) ---
POSTGRES_USER=todo_planner
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=todo_planner

# --- Backend ---
# Должен указывать на сервис db из docker-compose (совпадает с POSTGRES_* выше).
DATABASE_URL=postgresql+psycopg2://todo_planner:change-me-in-production@db:5432/todo_planner
SECRET_KEY=change-me-in-production
# Origin, с которого фронтенд обращается к backend (для CORS); при обычном
# запуске через docker-compose фронтенд и backend на одном origin через nginx
# reverse-proxy, но значение должно совпадать с публичным адресом фронтенда.
FRONTEND_ORIGIN=http://localhost

# --- Frontend (передаются как build args в Dockerfile фронтенда) ---
VITE_API_MODE=http
VITE_API_BASE_URL=/api
